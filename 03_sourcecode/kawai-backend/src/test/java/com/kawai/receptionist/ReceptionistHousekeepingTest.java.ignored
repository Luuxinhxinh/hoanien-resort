package com.kawai.receptionist;

import com.kawai.services.interfaces.HousekeepingService;
import com.kawai.services.interfaces.RoomService;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

import java.util.List;
import java.util.Map;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

/**
 * Unit tests for Receptionist (Front Office) — Housekeeping Coordination.
 *
 * Nghiệp vụ được kiểm thử (UC11, UC13):
 *   - Quản lý sơ đồ phòng (Room Matrix)
 *   - Cập nhật trạng thái phòng
 *   - Yêu cầu dọn gấp (Rush Room)
 */
@ExtendWith(MockitoExtension.class)
@DisplayName("Lễ tân — Điều phối Buồng phòng & Sơ đồ Phòng")
class ReceptionistHousekeepingTest {

    @Mock
    private HousekeepingService housekeepingService;

    @Mock
    private RoomService roomService;

    // ─── Rush Room ───────────────────────────────────────────────────────────

    @Test
    @DisplayName("UC11-01: Đánh dấu Rush Room thành công cho phòng hợp lệ")
    void markRushRoom_withValidRoomId_returnsTrue() {
        Long roomId = 101L;
        when(housekeepingService.markRushRoom(roomId)).thenReturn(true);

        boolean result = housekeepingService.markRushRoom(roomId);

        assertTrue(result, "Đánh dấu Rush Room phải thành công với phòng hợp lệ");
        verify(housekeepingService, times(1)).markRushRoom(roomId);
    }

    @Test
    @DisplayName("UC11-02: Đánh dấu Rush Room thất bại với phòng không tồn tại")
    void markRushRoom_withInvalidRoomId_returnsFalse() {
        Long invalidRoomId = 9999L;
        when(housekeepingService.markRushRoom(invalidRoomId)).thenReturn(false);

        boolean result = housekeepingService.markRushRoom(invalidRoomId);

        assertFalse(result, "Đánh dấu Rush Room phải thất bại với phòng không tồn tại");
    }

    @Test
    @DisplayName("UC11-03: Đánh dấu Rush Room được gọi đúng một lần")
    void markRushRoom_calledExactlyOnce() {
        Long roomId = 102L;
        when(housekeepingService.markRushRoom(roomId)).thenReturn(true);

        housekeepingService.markRushRoom(roomId);

        verify(housekeepingService, times(1)).markRushRoom(roomId);
        verifyNoMoreInteractions(housekeepingService);
    }

    // ─── Room Matrix ─────────────────────────────────────────────────────────

    @Test
    @DisplayName("UC13-01: Lấy sơ đồ phòng thành công — trả về danh sách không null")
    void getRoomMatrix_returnsNonNullList() {
        when(roomService.getRoomMatrix()).thenReturn(List.of(
                Map.of("roomId", 101L, "status", "CLEAN"),
                Map.of("roomId", 102L, "status", "DIRTY"),
                Map.of("roomId", 103L, "status", "OCCUPIED")
        ));

        List<Map<String, Object>> matrix = roomService.getRoomMatrix();

        assertNotNull(matrix, "Sơ đồ phòng không được trả về null");
        assertEquals(3, matrix.size(), "Sơ đồ phòng phải chứa đủ số phòng");
    }

    @Test
    @DisplayName("UC13-02: Sơ đồ phòng trả về rỗng khi chưa có dữ liệu")
    void getRoomMatrix_whenNoRooms_returnsEmptyList() {
        when(roomService.getRoomMatrix()).thenReturn(List.of());

        List<Map<String, Object>> matrix = roomService.getRoomMatrix();

        assertNotNull(matrix, "Kết quả không được null dù không có phòng");
        assertTrue(matrix.isEmpty(), "Danh sách phải rỗng khi chưa có dữ liệu phòng");
    }

    // ─── Cập nhật trạng thái phòng ───────────────────────────────────────────

    @Test
    @DisplayName("UC13-03: Cập nhật trạng thái phòng sang CLEAN thành công")
    void updateRoomStatus_toClean_returnsTrue() {
        Long roomId = 101L;
        when(roomService.updateRoomStatus(roomId, "CLEAN")).thenReturn(true);

        boolean result = roomService.updateRoomStatus(roomId, "CLEAN");

        assertTrue(result, "Cập nhật trạng thái phòng sang CLEAN phải thành công");
    }

    @Test
    @DisplayName("UC13-04: Cập nhật trạng thái phòng sang MAINTENANCE thành công")
    void updateRoomStatus_toMaintenance_returnsTrue() {
        Long roomId = 103L;
        when(roomService.updateRoomStatus(roomId, "MAINTENANCE")).thenReturn(true);

        boolean result = roomService.updateRoomStatus(roomId, "MAINTENANCE");

        assertTrue(result, "Cập nhật trạng thái phòng sang MAINTENANCE phải thành công");
    }

    @Test
    @DisplayName("UC13-05: Cập nhật trạng thái phòng thất bại với trạng thái không hợp lệ")
    void updateRoomStatus_withInvalidStatus_returnsFalse() {
        Long roomId = 101L;
        when(roomService.updateRoomStatus(roomId, "INVALID_STATUS")).thenReturn(false);

        boolean result = roomService.updateRoomStatus(roomId, "INVALID_STATUS");

        assertFalse(result, "Cập nhật trạng thái phải thất bại với trạng thái không hợp lệ");
    }
}
