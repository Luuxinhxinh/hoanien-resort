package com.kawai.receptionist;

import com.kawai.services.interfaces.BookingService;
import com.kawai.services.interfaces.FolioService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

/**
 * Unit tests for Receptionist (Front Office) — Booking Operations.
 *
 * Nghiệp vụ được kiểm thử (UC11, UC12):
 *   - Check-in khách
 *   - Check-out khách (kiểm tra Folio)
 *   - Đổi phòng
 */
@ExtendWith(MockitoExtension.class)
@DisplayName("Lễ tân — Nghiệp vụ Đặt phòng & Lưu trú")
class ReceptionistBookingTest {

    @Mock
    private BookingService bookingService;

    @Mock
    private FolioService folioService;

    // ─── Check-in ────────────────────────────────────────────────────────────

    @Test
    @DisplayName("UC12-01: Check-in thành công với booking hợp lệ")
    void checkIn_withValidBookingId_returnsTrue() {
        Long bookingId = 1L;
        when(bookingService.checkIn(bookingId)).thenReturn(true);

        boolean result = bookingService.checkIn(bookingId);

        assertTrue(result, "Check-in phải thành công khi booking hợp lệ");
        verify(bookingService, times(1)).checkIn(bookingId);
    }

    @Test
    @DisplayName("UC12-02: Check-in thất bại với booking không tồn tại")
    void checkIn_withInvalidBookingId_returnsFalse() {
        Long invalidBookingId = 999L;
        when(bookingService.checkIn(invalidBookingId)).thenReturn(false);

        boolean result = bookingService.checkIn(invalidBookingId);

        assertFalse(result, "Check-in phải thất bại khi booking không tồn tại");
    }

    @Test
    @DisplayName("UC12-03: Check-in không được gọi với bookingId null")
    void checkIn_withNullBookingId_shouldNotProceed() {
        // bookingId null không bao giờ được truyền vào service
        verifyNoInteractions(bookingService);
    }

    // ─── Check-out ───────────────────────────────────────────────────────────

    @Test
    @DisplayName("UC12-04: Check-out thành công khi Folio đã thanh toán đầy đủ (tổng nợ = 0)")
    void checkOut_whenFolioFullyPaid_returnsTrue() {
        Long bookingId = 1L;
        when(folioService.getTotalUnpaidAmount(bookingId)).thenReturn(0.0);
        when(bookingService.checkOut(bookingId)).thenReturn(true);

        double unpaid = folioService.getTotalUnpaidAmount(bookingId);
        boolean result = false;
        if (unpaid == 0.0) {
            result = bookingService.checkOut(bookingId);
        }

        assertEquals(0.0, unpaid, "Folio phải không còn số tiền chưa thanh toán");
        assertTrue(result, "Check-out phải thành công khi Folio đã thanh toán đầy đủ");
        verify(bookingService, times(1)).checkOut(bookingId);
    }

    @Test
    @DisplayName("UC12-05: Check-out bị chặn khi Folio còn tiền chưa thanh toán")
    void checkOut_whenFolioHasUnpaidAmount_shouldBeBlocked() {
        Long bookingId = 2L;
        when(folioService.getTotalUnpaidAmount(bookingId)).thenReturn(500_000.0);

        double unpaid = folioService.getTotalUnpaidAmount(bookingId);
        boolean checkoutAllowed = (unpaid == 0.0);

        assertFalse(checkoutAllowed, "Check-out phải bị chặn khi Folio vẫn còn công nợ chưa thanh toán");
        verify(bookingService, never()).checkOut(bookingId);
    }

    @Test
    @DisplayName("UC12-06: Check-out thất bại với booking không tồn tại")
    void checkOut_withInvalidBookingId_returnsFalse() {
        Long invalidId = 999L;
        when(bookingService.checkOut(invalidId)).thenReturn(false);

        boolean result = bookingService.checkOut(invalidId);

        assertFalse(result, "Check-out phải thất bại khi booking không tồn tại");
    }

    // ─── Đổi phòng ──────────────────────────────────────────────────────────

    @Test
    @DisplayName("UC12-07: Đổi phòng thành công khi phòng mới hợp lệ")
    void changeRoom_withValidRoomId_returnsTrue() {
        Long bookingId = 1L;
        Long newRoomId = 10L;
        when(bookingService.changeRoom(bookingId, newRoomId)).thenReturn(true);

        boolean result = bookingService.changeRoom(bookingId, newRoomId);

        assertTrue(result, "Đổi phòng phải thành công khi phòng mới hợp lệ và còn trống");
        verify(bookingService, times(1)).changeRoom(bookingId, newRoomId);
    }

    @Test
    @DisplayName("UC12-08: Đổi phòng thất bại khi phòng mới đã có khách")
    void changeRoom_whenRoomAlreadyOccupied_returnsFalse() {
        Long bookingId = 1L;
        Long occupiedRoomId = 20L;
        when(bookingService.changeRoom(bookingId, occupiedRoomId)).thenReturn(false);

        boolean result = bookingService.changeRoom(bookingId, occupiedRoomId);

        assertFalse(result, "Đổi phòng phải thất bại khi phòng mới đã có khách");
    }

    @Test
    @DisplayName("UC12-09: Đổi phòng thất bại khi booking không tồn tại")
    void changeRoom_withInvalidBookingId_returnsFalse() {
        Long invalidBookingId = 999L;
        Long newRoomId = 5L;
        when(bookingService.changeRoom(invalidBookingId, newRoomId)).thenReturn(false);

        boolean result = bookingService.changeRoom(invalidBookingId, newRoomId);

        assertFalse(result, "Đổi phòng phải thất bại khi booking không tồn tại");
    }
}
